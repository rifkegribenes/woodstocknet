{
  "hosting": {
    "public": "public",
    "headers": [
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/radio",
        "destination": "/radio.html"
      },
      {
        "source": "/pods",
        "destination": "/pods.html"
      },
      { "source": "!/**/*.@(css|js|png|jpg|svg|ico)", "destination": "/index.html" }
    ]
  }
}